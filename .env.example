# Copy this file to ".env" and fill in your own values.
# The real ".env" is ignored by git, so your key never leaves your computer.

# Key from Google AI Studio (used while building and testing)
GEMINI_API_KEY=

# Which Gemini model to use. Check the current names in AI Studio.
GEMINI_FAST_MODEL=
GEMINI_SMART_MODEL=

# Google Cloud settings (only needed once we deploy)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
