# Copy this file to ".env" and fill in your own values.
# The real ".env" is ignored by git, so your key never leaves your computer.

# Key from Google AI Studio (used while building and testing)
GEMINI_API_KEY=

# Which Gemini models to use. Leave blank to use the defaults in the code.
# Defaults: gemini-3.5-flash-lite (quick and cheap) and gemini-3.8-flash (stronger).
GEMINI_FAST_MODEL=
GEMINI_SMART_MODEL=

# Google Cloud settings (only needed once we deploy)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
