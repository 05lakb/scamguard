# Copy this file to ".env" in the repository root and fill in your own values.
# The real ".env" is ignored by git, so your key never leaves your computer.

# --- Local run ---------------------------------------------------------------

# Optional. A key from Google AI Studio turns on Gemini reading on your laptop.
# Without it the app still runs: message reading and Voice AI fall back to phrase rules, and the screen says so.
GEMINI_API_KEY=

# Keep cases and analyst decisions in memory while the API runs, so the Cases page works locally.
# (Leave it out and nothing is saved between requests. Firestore is only used when LMG_FIRESTORE=1.)
LMG_STORE=memory

# Which Gemini models to use. Leave blank for the defaults in the code.
GEMINI_FAST_MODEL=
GEMINI_SMART_MODEL=

# Per Gemini request, in milliseconds (1,000 to 60,000).
GEMINI_TIMEOUT_MS=20000

# --- Google Cloud (set by infra/deploy.sh; not needed on a laptop) ------------

# USE_VERTEX=1 calls Gemini through Vertex AI with the Cloud Run service account (no API key).
# USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_LOCATION=global

# LMG_FIRESTORE=1 saves cases and decisions in Firestore (database must exist; documents expire after 24 hours).
# LMG_FIRESTORE=1
